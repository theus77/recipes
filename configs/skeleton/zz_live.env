EMSCH_TEMPLATE_ERROR='@EMSCH/template/error{code}.html.twig'
ENVIRONMENT_ALIAS='${ENVIRONMENT_ALIAS_BASE_PATH}recipes_ma_live'
EMSCH_ENVS='{"recipes_live":{"regex":"/.*/","alias":"recipes_ma_live","request":{"_locale":"fr"}}}'
