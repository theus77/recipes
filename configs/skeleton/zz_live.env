NGINX_CUSTOM_ASSETS_RC='/(bundles|skeleton)/'

PROTECTED_URL=/not-protected/

APP_SECRET='644e6afb0a0baca42c12529f439d3b78'
DEFAULT_LOCAL='fr'

EMS_STORAGES='[{"type":"fs","path":"/tmp/assets","usage":"cache"},{"type":"http","usage":"external","base-url":"${BACKEND_URL}"}]'
EMS_CACHE_PREFIX='recipes_'

EMSCH_LOCALES='["fr"]'
EMSCH_BIND_LOCALE=false
EMSCH_BACKEND_URL='${BACKEND_URL}'
EMSCH_ENV='recipes_live'
EMSCH_TRANSLATION_TYPE='label'
EMSCH_ROUTE_TYPE='route'
EMSCH_TEMPLATES='{"template":{"name":"name","code":"body"},"template_ems":{"name":"name","code":"body"}}'
