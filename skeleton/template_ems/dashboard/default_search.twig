{% block ems_body %}

    {% set form = emsco_form('dashboard_default_search_options', { locale: app.user.localePreferred|default('nl') }, {
        method: 'GET',
    }) %}
    {% set formView = form.createView %}

    <div class="box with-border">
        <div class="box-header with-border">
            <h2 class="box-title">Options</h2>
        </div>
        <div class="box-body">
            {{ form_start(formView) }}
            {{ form_row(formView.('dashboard_default_search_options'), {class: 'col-md-4'}) }}
            <div class="clearfix"></div>
            <div class="col-md-12">
                {#                <button type="submit" class="btn btn-primary"><i class="fa fa-eye"></i> Apply</button>#}
            </div>
            {{ form_end(formView) }}
        </div>
    </div>


    <div class="box with-border">
        <div class="box-header with-border">
            <h2 class="box-title">Search</h2>
        </div>
        <div class="box-body">
            {{ emsco_datatable(['preview'],['recipe'], {
                "query": {
                    "multi_match": {
                        "query": "%query%",
                        "operator": "and",
                        "type": "bool_prefix",
                        "fields": [
                            "live_search_fr",
                            "live_search_fr._2gram",
                            "live_search_fr._3gram"
                        ]
                    }
                },
                "columns": [{
                    "label": "Label",
                    "template": "<a href=\"{{ path('emsco_view_revisions', {ouuid: data.id, type: data.contentType} ) }}\">{{ data.source.title }}</a>",
                    "orderField": "title.alpha_order"
                },{
                    "label": "Type",
                    "template": "{{ {appetizer: 'Apéritif',starter: 'Entrée',soup: 'Soupe',salad: 'Salade',main_course: 'Plat principal',side_dish: 'Accompagnement',pasta: 'Pâtes',rice: 'Riz',pizza: 'Pizza',quiche_tart: 'Quiche et tarte salée',sandwich_wrap: 'Sandwich et wrap',meat: 'Viande',poultry: 'Volaille',fish: 'Poisson',seafood: 'Fruits de mer',vegetarian: 'Végétarien',dessert: 'Dessert',cake_pastry: 'Gâteau et pâtisserie',breakfast: 'Petit-déjeuner',snack: 'En-cas',sauce: 'Sauce',drink: 'Boisson',cocktail: 'Cocktail',bread: 'Pain'}.(data.source.type) }}",
                    "orderField": "type"
                }]
            }) }}
        </div>
    </div>
{% endblock %}
